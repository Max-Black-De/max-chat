# Конфигурация сборки (Vite). Все переменные необязательны.
# Скопируйте в .env.local при необходимости; .env* (кроме этого файла) в .gitignore.
#
# idInstance и apiTokenInstance здесь НЕ задаются: они вводятся в форме входа (ТЗ ОР-1)
# и хранятся только в sessionStorage. Любая переменная VITE_* попадает в собранный бандл,
# поэтому токен в env класть нельзя (НФТ-3).

# Адрес API, которым предзаполняется поле apiUrl на форме входа (Р-1).
# Точный адрес вашего инстанса — в console.green-api.com → инстанс → apiUrl.
VITE_DEFAULT_API_URL=https://api.green-api.com

# Д-7: история чата через getChatHistory (опционально, по умолчанию выключено).
VITE_FEATURE_HISTORY=false
